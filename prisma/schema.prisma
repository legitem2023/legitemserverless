generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  username      String    @unique
  email         String    @unique
  password      String
  profilePicture String?
  status        UserStatus @default(OFFLINE)
  lastSeen      DateTime  @default(now())
  
  sentMessages  Message[]  @relation("SenderMessages")
  chats         ChatParticipant[]
  createdGroups Chat[]     @relation("CreatedGroups")
  typingIn      TypingStatus[]
  readMessages  MessageReadBy[]
  deliveredMessages MessageDeliveredTo[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Chat {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  isGroup       Boolean   @default(false)
  createdBy     String?   @map("created_by") @db.ObjectId
  
  creator       User?     @relation("CreatedGroups", fields: [createdBy], references: [id])
  participants  ChatParticipant[]
  messages      Message[]
  typingStatus  TypingStatus[]
  lastMessageId String?   @map("last_message_id") @db.ObjectId
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("chats")
}

model ChatParticipant {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  chatId        String    @map("chat_id") @db.ObjectId
  userId        String    @map("user_id") @db.ObjectId
  joinedAt      DateTime  @default(now())
  
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_participants")
}

model Message {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  chatId        String    @map("chat_id") @db.ObjectId
  senderId      String    @map("sender_id") @db.ObjectId
  content       String
  type          MessageType @default(TEXT)
  attachments   Json?      @default("[]")
  
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User      @relation("SenderMessages", fields: [senderId], references: [id])
  readBy        MessageReadBy[]
  deliveredTo   MessageDeliveredTo[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageReadBy {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId     String    @map("message_id") @db.ObjectId
  userId        String    @map("user_id") @db.ObjectId
  readAt        DateTime  @default(now())
  
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_read_by")
}

model MessageDeliveredTo {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId     String    @map("message_id") @db.ObjectId
  userId        String    @map("user_id") @db.ObjectId
  deliveredAt   DateTime  @default(now())
  
  message       Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_delivered_to")
}

model TypingStatus {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @map("user_id") @db.ObjectId
  chatId        String    @map("chat_id") @db.ObjectId
  isTyping      Boolean   @default(true)
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@map("typing_statuses")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  SYSTEM
}
